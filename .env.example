# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Optional: Database (future use)
# DATABASE_URL=postgresql://user:password@localhost/rebate_db

# Security
# Note: API keys are NEVER stored in .env
# They are entered via Dashboard and stored in browser localStorage only
