# Binance API (READ-ONLY KEYS ONLY!)
BINANCE_API_KEY=your_read_only_api_key
BINANCE_API_SECRET=your_read_only_secret

# Server Config
PORT=3000
NODE_ENV=development

# Redis (optional for dev, required for prod)
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_prod
